@TestExam_HostAddress = http://localhost:5139

# Ajusta estos IDs según lo creado en tu base.
@direccionId = 1
@clienteId = 1
@etapaId = 1
@operarioId = 1
@operarioEtapaId = 1
@facturaId = 1
@materiaPrimaId = 1

###
### MateriaPrima - GET all
GET {{TestExam_HostAddress}}/MateriaPrima
Accept: application/json

###
### MateriaPrima - GET by filters
GET {{TestExam_HostAddress}}/MateriaPrima?nombre=Hari&descripcion=trigo
Accept: application/json

###
### MateriaPrima - GET by id
GET {{TestExam_HostAddress}}/MateriaPrima/{{materiaPrimaId}}
Accept: application/json

###
### MateriaPrima - POST
POST {{TestExam_HostAddress}}/MateriaPrima
Content-Type: application/json

{
  "nombre": "Levadura",
  "descripcion": "Levadura seca",
  "cantidad": 20
}

###
### MateriaPrima - PUT
PUT {{TestExam_HostAddress}}/MateriaPrima/{{materiaPrimaId}}
Content-Type: application/json

{
  "id": 0,
  "nombre": "Levadura instantanea",
  "descripcion": "Levadura seca premium",
  "cantidad": 25
}

###
